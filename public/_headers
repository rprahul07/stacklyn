# Stacklyn — HTTP performance + security headers
# Applied by Cloudflare Pages / Nitro on every response

# ── Immutable hashed JS + CSS chunks (Vite appends content hash to filename)
# Safe to cache for 1 year; the hash changes whenever content changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── Static public assets (icons, images, fonts referenced by path)
/favicon.*
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
/og-image.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
/logo.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

# ── Sitemaps and llms.txt — short cache so Googlebot picks up updates quickly
/sitemap.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=600
/ai-sitemap.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=600
/llms.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=600
/robots.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=600

# ── HTML pages — short cache + stale-while-revalidate so bots and users
# always get fresh content while a background revalidation happens silently.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
